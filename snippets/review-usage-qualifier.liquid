{%- doc -%}
  Composes usage line from buyer/recipient dropdown answers (§5.1 lock).
  @param {string} how_often - Daily | Weekly | Occasionally
  @param {string} where_it_lives - Pocket | Bag | Home
  @param {string} dugout_experience - Dugout veteran | Dugout rookie
  @param {boolean} [filterable] - When true, each tag is a filter trigger (M8)
{%- enddoc -%}

{%- liquid
  assign how_often = how_often | default: '' | strip
  assign where_it_lives = where_it_lives | default: '' | strip
  assign dugout_experience = dugout_experience | default: '' | strip
  assign filterable = filterable | default: false

  assign freq_label = ''
  case how_often
    when 'Daily'
      assign freq_label = 'Daily user'
    when 'Weekly'
      assign freq_label = 'Weekly user'
    when 'Occasionally'
      assign freq_label = 'Occasional user'
  endcase

  assign location_label = ''
  case where_it_lives
    when 'Pocket'
      assign location_label = 'Pocket carry'
    when 'Bag'
      assign location_label = 'Bag carry'
    when 'Home'
      assign location_label = 'Home use'
  endcase
-%}

{%- if freq_label != blank or location_label != blank or dugout_experience != blank -%}
  <div class="reviews-card__usage{% if filterable %} reviews-card__usage--filterable{% endif %}">
    {%- if freq_label != blank -%}
      {%- if filterable and how_often != blank -%}
        <button
          type="button"
          class="reviews-card__pill reviews-card__filter-trigger"
          data-reviews-filter-trigger="frequency"
          data-filter-value="{{ how_often | escape }}"
          data-filter-mode="add"
          aria-pressed="false"
        >{{ freq_label }}</button>
      {%- else -%}
        <span class="reviews-card__usage-part">{{ freq_label }}</span>
      {%- endif -%}
    {%- endif -%}

    {%- if location_label != blank -%}
      {%- if filterable and where_it_lives != blank -%}
        <button
          type="button"
          class="reviews-card__pill reviews-card__filter-trigger"
          data-reviews-filter-trigger="carry"
          data-filter-value="{{ where_it_lives | escape }}"
          data-filter-mode="add"
          aria-pressed="false"
        >{{ location_label }}</button>
      {%- else -%}
        <span class="reviews-card__usage-part">{{ location_label }}</span>
      {%- endif -%}
    {%- endif -%}

    {%- if dugout_experience != blank -%}
      {%- if filterable -%}
        <button
          type="button"
          class="reviews-card__pill reviews-card__filter-trigger"
          data-reviews-filter-trigger="experience"
          data-filter-value="{{ dugout_experience | escape }}"
          data-filter-mode="add"
          aria-pressed="false"
        >{{ dugout_experience | escape }}</button>
      {%- else -%}
        <span class="reviews-card__usage-part">{{ dugout_experience | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
