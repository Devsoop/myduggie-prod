{% doc %}
  Renders the bundle outline composition area.

  Displays per-product outline images arranged in constituent_items order.
  When colors are selected, outlines swap to the corresponding variant images.
  Color names appear below each item once selected.

  @param constituent_items {array} - Array of product references in display order
  @param item_count {number} - Number of constituent items
{% enddoc %}

{% comment %}
  =============================================================================
  BUNDLE OUTLINE COMPOSITION
  =============================================================================
  Visual diagram showing silhouettes of each product in the bundle. This gives
  the user a spatial sense of what they're building.

  State machine per outline item (controlled by CSS classes set by JS):
  1. Default → shows outline image (or placeholder if no outline metafield)
  2. Loading (--loading) → spinner overlay + blur on current image
  3. Filled (--filled) → cross-fades outline to the selected variant's image

  Data attributes consumed by BundleConfigurator JS:
  - [data-outline-composition]: root container marker
  - [data-outline-item]: each product's outline card
  - [data-product-id]: links outline item to its picker and selection
  - [data-product-handle]: used for /products/{handle}.js API fallback
  - [data-outline-image]: the static outline/silhouette image
  - [data-color-image]: the variant image (hidden initially, shown on fill)
  - [data-color-name]: text label updated with selected color name
  - [data-special-badge]: "LE" badge shown for special edition colors
  =============================================================================
{% endcomment %}

<div
  class="bundle-outline"
  data-outline-composition
  data-item-count="{{ item_count }}"
>
  <div class="bundle-outline__items">
    {% for item in constituent_items %}
      {% liquid
        # Resolve product reference — handles both metafield types:
        # - product_reference type (item.type == 'product_reference', value is the product)
        # - direct product object (item.id exists)
        assign item_product = item
        if item.type == 'product_reference'
          assign item_product = item.value
        elsif item.id
          assign item_product = item
        endif

        # Read the outline silhouette image from product metafield
        # This is a custom image uploaded per product showing the product shape
        assign item_outline = item_product.metafields.custom.outline_image.value
        assign outline_image_alt = item_product.title | escape
        assign outline_placeholder_text = 'bundles.outline_placeholder' | t: title: outline_image_alt
      %}

      {% if item_product != blank %}
        {% comment %}
          Each outline item is a vertical card with:
          1. Image wrapper (contains outline + hidden color image, layered via position: absolute)
          2. Label area (color name + optional special edition badge)

          The image wrapper uses ::before (spinner) and ::after (backdrop blur)
          pseudo-elements for the loading state animation.
        {% endcomment %}
        <div
          class="bundle-outline__item"
          data-outline-item
          data-product-id="{{ item_product.id }}"
          data-product-handle="{{ item_product.handle }}"
          data-picker-index="{{ forloop.index0 }}"
        >
          <div class="bundle-outline__image-wrapper">
            {% comment %} Static outline image — visible by default, fades out when color is selected {% endcomment %}
            {% if item_outline != blank %}
              {{
                item_outline
                | image_url: width: 300
                | image_tag:
                  loading: 'eager',
                  alt: outline_image_alt,
                  class: 'bundle-outline__image bundle-outline__image--outline',
                  data-outline-image: true
              }}
            {% else %}
              {% comment %} Fallback placeholder when no outline image metafield exists {% endcomment %}
              <div class="bundle-outline__placeholder">
                {{ outline_placeholder_text }}
              </div>
            {% endif %}

            {% comment %}
              Color variant image — hidden initially (display: none).
              JS sets src and shows this when a color is selected.
              Fades in via CSS opacity transition when --filled class is added.
              Initial src is a transparent placeholder to avoid broken image icon.
            {% endcomment %}
            <img
              class="bundle-outline__image bundle-outline__image--color"
              data-color-image
              data-product-id="{{ item_product.id }}"
              src="{{ 'icon-unavailable.svg' | asset_url }}"
              alt=""
              loading="lazy"
              width="300"
              height="300"
              style="display: none;"
            >
          </div>

          {% comment %} Label area — color name stacked above optional "Limited Run" badge {% endcomment %}
          <div class="bundle-outline__label">
            <span
              class="bundle-outline__color-name"
              data-color-name
              data-product-id="{{ item_product.id }}"
            ></span>
            <span
              class="bundle-outline__special-badge"
              data-special-badge
              style="display: none;"
            >
              {{ 'bundles.special_edition_badge' | t: default: 'LE' }}
            </span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% comment %}
  =============================================================================
  STYLES
  =============================================================================
  Uses CSS custom properties inherited from the parent .bundle-page section.
  Falls back to hardcoded values for standalone rendering/preview.

  Key visual behaviors:
  - Outline items are horizontally centered in a flex row with responsive gap
  - Images are absolutely positioned within the wrapper (stacked)
  - Loading state: ::before is a spinning border ring, ::after is a blurred backdrop
  - Filled state: outline image fades to opacity 0, color image fades to opacity 1
  - Special edition badge is a small pill with inverted colors
  =============================================================================
{% endcomment %}
{% stylesheet %}
  /* ---- Container ---- */
  /* Tight equal padding so the box hugs the content —
     2-item bundles won't look like a half-empty card. */
  .bundle-outline {
    background: var(--bundle-bg, #FFFFFF);
    border: 2px solid rgba(0, 0, 0, 0.5);
    border-radius: var(--bundle-radius, 8px);
    padding: 0;
    margin-bottom: var(--bundle-space-lg, 24px);
  }

  /* 2-item bundles (The Pair) — cells are wider so images need
     center positioning to avoid cropping the tall Lil' Duggie.
     Slight inset so the Duggie doesn't touch the top border. */
  .bundle-outline[data-item-count='2'] .bundle-outline__image {
    object-position: center center;
    inset: 0.5rem 0;
    height: calc(100% - 1rem);
  }

  /* 4-item bundles (Complete Carry) — squarer aspect ratio to reduce
     vertical whitespace. Cells are narrower so images are smaller;
     a tighter wrapper keeps spacing similar to The Pair. */
  .bundle-outline[data-item-count='4'] .bundle-outline__image-wrapper {
    aspect-ratio: 1 / 1;
  }

  .bundle-outline[data-item-count='4'] .bundle-outline__image {
    inset: 0.375rem 0;
    height: calc(100% - 0.75rem);
  }

  /* ---- Horizontal item layout ---- */
  .bundle-outline__items {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
  }



  /* ---- Individual outline item (one per constituent product) ---- */
  /* Each item gets an equal slice of the row (flex: 1 1 0).
     padding-inline uses a fixed value so it doesn't eat too much
     on narrow cells (4-item bundles). */
  .bundle-outline__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex: 1 1 0;
    padding-inline: 0.25rem;
    transition: opacity 180ms var(--bundle-ease-out, ease);
  }

  /* ---- Image wrapper — contains stacked outline + color images ---- */
  /* Both images are position: absolute inside this container.
     The wrapper's fixed height prevents layout shift during transitions. */
  /* max-height caps tall cells (e.g. 2-item bundles where each cell is wide)
     so the box doesn't stretch into a half-empty card. */
  .bundle-outline__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 18rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ---- Loading state pseudo-elements ----
     ::before = spinning ring indicator (circular border animation)
     ::after = semi-transparent backdrop that dims the current image
     Both start at opacity: 0 and are revealed via --loading class */
  .bundle-outline__image-wrapper::before,
  .bundle-outline__image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms var(--bundle-ease-out, ease);
  }

  /* Spinner ring — centered, spins via keyframe animation */
  .bundle-outline__image-wrapper::before {
    inset: auto;
    width: 2rem;
    height: 2rem;
    top: 50%;
    left: 50%;
    margin-top: -1rem;
    margin-left: -1rem;
    z-index: 3;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, var(--bundle-text-primary, #1F1F1E) 16%, transparent);
    border-top-color: var(--bundle-text-primary, #1F1F1E); /* Only top border is opaque = spinner effect */
    will-change: transform, opacity;
  }

  /* Backdrop overlay — dims the image behind the spinner */
  .bundle-outline__image-wrapper::after {
    z-index: 2;
    background: color-mix(in oklab, var(--bundle-bg, #FFFFFF) 68%, transparent);
    will-change: opacity;
  }

  /* ---- Base image styles (shared by outline + color images) ---- */
  .bundle-outline__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    object-fit: contain;
    transition:
      opacity 160ms var(--bundle-ease-in-out, ease),
      filter 260ms var(--bundle-ease-out, ease);
  }


  /* Color variant image — starts invisible, fades in when --filled class is added */
  .bundle-outline__image--color {
    opacity: 0;
  }

  /* ---- Placeholder (no outline image available) ---- */
  .bundle-outline__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bundle-bg-accent, #F5F2ED);
    border-radius: var(--bundle-radius, 8px);
    font-size: 12px;
    color: var(--bundle-text-tertiary, #888780);
    text-align: center;
    padding: 12px;
    transition:
      opacity 160ms var(--bundle-ease-in-out, ease),
      filter 260ms var(--bundle-ease-out, ease);
  }

  /* ---- FILLED STATE ----
     When a color is selected and image is loaded:
     - Outline image / placeholder fades out (opacity: 0)
     - Color variant image fades in (opacity: 1) */
  .bundle-outline__item--filled .bundle-outline__image--outline,
  .bundle-outline__item--filled .bundle-outline__placeholder {
    opacity: 0;
  }

  .bundle-outline__item--filled .bundle-outline__image--color {
    opacity: 1;
  }

  /* ---- LOADING STATE ----
     While variant image is being fetched/preloaded:
     - Backdrop overlay becomes visible (dims current image)
     - Spinner ring appears and rotates
     - Current images get subtle blur + desaturation */
  .bundle-outline__item--loading .bundle-outline__image-wrapper::after {
    opacity: 0.8;
  }

  .bundle-outline__item--loading .bundle-outline__image-wrapper::before {
    opacity: 1;
    animation: bundle-outline-spinner 720ms linear infinite;
  }

  .bundle-outline__item--loading .bundle-outline__image--outline,
  .bundle-outline__item--loading .bundle-outline__image--color,
  .bundle-outline__item--loading .bundle-outline__placeholder {
    filter: blur(0.75px) saturate(0.92);
  }

  /* ---- Color name label + special edition badge ---- */
  .bundle-outline__label {
    margin-top: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 0.125rem;
    position: relative;
  }

  .bundle-outline__label:has(.bundle-outline__color-name:not(:empty)) {
    padding-block: 0.25rem 0.375rem;
  }

  .bundle-outline__color-name {
    font-size: 0.8875rem;
    font-weight: 500;
    color: var(--bundle-text-primary, #1F1F1E);
    line-height: 1.2;
    white-space: nowrap;
  }

  /* "Limited Run" badge — sits tight below color name */
  .bundle-outline__special-badge {
    font-size: 0.625rem;
    font-weight: 700;
    background: var(--bundle-text-primary, #1F1F1E);
    color: var(--bundle-bg, #FFFFFF);
    padding: 0.125rem 0.3rem;
    border-radius: 999px;
    line-height: 1;
  }

  /* ---- Spinner rotation keyframe ---- */
  @keyframes bundle-outline-spinner {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  /* ---- Mobile (<750px) ----
     Same equal-cell rule applies; tighter padding, slightly
     squarer aspect ratio, smaller label text */
  @media screen and (max-width: 749px) {
    .bundle-outline {
      padding: 0;
    }

    .bundle-outline__image-wrapper {
      aspect-ratio: 4 / 5;
      max-height: 14rem;
    }

    .bundle-outline__color-name {
      font-size: 0.6rem;
      white-space: nowrap;
    }

    .bundle-outline__special-badge {
      font-size: 0.4rem;
      padding: 0.075rem 0.2rem;
    }
  }
{% endstylesheet %}
