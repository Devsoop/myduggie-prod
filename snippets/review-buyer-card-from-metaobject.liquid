{%- doc -%}
  Render one buyer review card from a Review metaobject entry (M2).
  @param {object} review_entry - shop.metaobjects.review entry
  @param {string} verified_buyer_label
  @param {string} sample_label
  @param {string} returns_label
  @param {number} photo_limit
{%- enddoc -%}

{%- liquid
  assign review_id = review_entry.system.handle | default: review_entry.handle
  assign rating = review_entry.rating.value
  assign submitted_at = review_entry.submitted_at.value
  assign is_sample = review_entry.is_sample.value

  # §4.1 — single `reviewer_name` field (e.g. "Alex Rivera"); card renders first + last initial.
  assign reviewer_name = review_entry.reviewer_name.value
  assign reviewer_first = ''
  assign reviewer_last = ''
  if reviewer_name != blank
    capture reviewer_name_parts
      render 'review-reviewer-name-parts', reviewer_name: reviewer_name
    endcapture
    assign reviewer_name_parts = reviewer_name_parts | strip | split: '|'
    assign reviewer_first = reviewer_name_parts[0]
    assign reviewer_last = reviewer_name_parts[1]
  endif

  assign answers = review_entry.answers.value

  # TEMP-DEV (Brian M2 QA — Returns badge demo). Remove before M3 prod.
  # M3: live fulfillment lookup on order_id (§5.6), not a stored review field.
  # Seed Option A: optional boolean `order_returned` on Review metaobject in Admin.
  # Seed Option B (no new field): `"order_returned": true` inside `answers` JSON — see reviews-metaobject-seed.md.
  assign order_returned = false
  if review_entry.order_returned.value == true
    assign order_returned = true
  endif
  if order_returned == false and answers.order_returned == true
    assign order_returned = true
  endif

  assign how_often = answers.how_often
  assign where_it_lives = answers.where_it_lives
  assign dugout_experience = answers.dugout_experience

  assign prose_1_label = ''
  assign prose_1_body = ''
  assign prose_2_label = ''
  assign prose_2_body = ''
  assign prose_3_label = ''
  assign prose_3_body = ''

  if answers.prose != blank
    for prose_item in answers.prose
      if forloop.index == 1
        assign prose_1_label = prose_item.display_label | default: prose_item.label
        assign prose_1_body = prose_item.body
      elsif forloop.index == 2
        assign prose_2_label = prose_item.display_label | default: prose_item.label
        assign prose_2_body = prose_item.body
      elsif forloop.index == 3
        assign prose_3_label = prose_item.display_label | default: prose_item.label
        assign prose_3_body = prose_item.body
      endif
    endfor
  endif

  assign photos = review_entry.photos.value
  assign photo_count = photos | size | default: 0
  assign photo_1_url = ''
  assign photo_1_alt = ''
  assign photo_2_url = ''
  assign photo_2_alt = ''
  if photos != blank
    for photo in photos
      if forloop.index == 1
        assign photo_1_url = photo.url
        assign photo_1_alt = photo.alt
      elsif forloop.index == 2
        assign photo_2_url = photo.url
        assign photo_2_alt = photo.alt
      endif
    endfor
  endif

  assign owns_products = review_entry.owns.value
  assign owns_count = owns_products | size | default: 0
  assign owns_color_variants = review_entry.owns_colors.value

  assign own_1_icon_type = ''
  assign own_1_color_hex = ''
  assign own_1_outline_url = ''
  assign own_2_icon_type = ''
  assign own_2_color_hex = ''
  assign own_2_outline_url = ''
  assign own_3_icon_type = ''
  assign own_3_color_hex = ''
  assign own_3_outline_url = ''
-%}

{%- if owns_products != blank -%}
  {%- for product in owns_products -%}
    {%- liquid
      assign catalog_product = product
      if product.handle != blank
        assign catalog_product = all_products[product.handle]
        if catalog_product == empty
          assign catalog_product = product
        endif
      endif
    -%}

    {%- capture icon_type -%}{% render 'review-icon-type-from-handle', handle: catalog_product.handle %}{%- endcapture -%}
    {%- assign icon_type = icon_type | strip -%}

    {%- assign color_hex = '#1F1F1E' -%}
    {%- assign product_index = forloop.index -%}
    {%- if owns_color_variants != blank -%}
      {%- for owns_color_entry in owns_color_variants -%}
        {%- if forloop.index == product_index -%}
          {%- capture color_hex -%}
            {%- render 'review-variant-color-hex', owns_color_entry: owns_color_entry, catalog_product: catalog_product -%}
          {%- endcapture -%}
          {%- assign color_hex = color_hex | strip -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- capture outline_resolve -%}{% render 'review-product-outline-url', product: catalog_product %}{%- endcapture -%}
    {%- assign outline_resolve_parts = outline_resolve | strip | split: '|' -%}
    {%- assign outline_url = outline_resolve_parts[0] -%}
    {%- if outline_url == blank -%}
      {%- case icon_type -%}
        {%- when 'keychain' -%}
          {%- assign outline_url = 'review-outline-keychain.svg' | asset_url -%}
        {%- when 'pipe' -%}
          {%- assign outline_url = 'review-outline-pipe.svg' | asset_url -%}
        {%- else -%}
          {%- assign outline_url = 'review-outline-duggie.svg' | asset_url -%}
      {%- endcase -%}
    {%- endif -%}

    {%- if forloop.index == 1 -%}
      {%- assign own_1_icon_type = icon_type -%}
      {%- assign own_1_color_hex = color_hex -%}
      {%- assign own_1_outline_url = outline_url -%}
    {%- elsif forloop.index == 2 -%}
      {%- assign own_2_icon_type = icon_type -%}
      {%- assign own_2_color_hex = color_hex -%}
      {%- assign own_2_outline_url = outline_url -%}
    {%- elsif forloop.index == 3 -%}
      {%- assign own_3_icon_type = icon_type -%}
      {%- assign own_3_color_hex = color_hex -%}
      {%- assign own_3_outline_url = outline_url -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% render 'review-card-buyer',
  review_id: review_id,
  rating: rating,
  reviewer_first: reviewer_first,
  reviewer_last: reviewer_last,
  submitted_at: submitted_at,
  order_returned: order_returned,
  is_sample: is_sample,
  how_often: how_often,
  where_it_lives: where_it_lives,
  dugout_experience: dugout_experience,
  photo_count: photo_count,
  owns_count: owns_count,
  prose_1_label: prose_1_label,
  prose_1_body: prose_1_body,
  prose_2_label: prose_2_label,
  prose_2_body: prose_2_body,
  prose_3_label: prose_3_label,
  prose_3_body: prose_3_body,
  photo_1_url: photo_1_url,
  photo_1_alt: photo_1_alt,
  photo_2_url: photo_2_url,
  photo_2_alt: photo_2_alt,
  own_1_icon_type: own_1_icon_type,
  own_1_color_hex: own_1_color_hex,
  own_1_outline_url: own_1_outline_url,
  own_2_icon_type: own_2_icon_type,
  own_2_color_hex: own_2_color_hex,
  own_2_outline_url: own_2_outline_url,
  own_3_icon_type: own_3_icon_type,
  own_3_color_hex: own_3_color_hex,
  own_3_outline_url: own_3_outline_url,
  verified_buyer_label: verified_buyer_label,
  sample_label: sample_label,
  returns_label: returns_label,
  photo_limit: photo_limit
%}
