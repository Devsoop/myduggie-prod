{%- doc -%}
  Shared filter facet sections (§4.6) for desktop sidebar and mobile drawer.
  Always emits data-reviews-filter; drawer callers rewrite to data-reviews-drawer-filter.
  @param {string} [id_prefix] - prefix for input ids (avoids duplicates when both surfaces render)
  @param {string} [color_html] - prebuilt color facet rows
  @param {string} [owns_html] - prebuilt owns facet rows
{%- enddoc -%}

{%- liquid
  assign id_prefix = id_prefix | default: 'sf'
  assign color_rows = color_html | default: facet_color_html | default: ''
  assign owns_rows = owns_html | default: facet_owns_html | default: ''
-%}

{%- if facet_reviewer_buyer > 0 or facet_reviewer_recipient > 0 or facet_reviewer_gifter > 0 or facet_reviewer_sample > 0 -%}
  <details class="reviews-filter__details" data-reviews-filter-section="reviewer" open>
    <summary class="reviews-filter__heading reviews-filter__summary">Reviewer</summary>
    <ul class="reviews-filter__list list-unstyled">
      {%- if facet_reviewer_buyer > 0 -%}
        <li class="reviews-filter__item">
          <label class="reviews-filter__label" for="{{ id_prefix }}-reviewer-buyer">
            <input
              id="{{ id_prefix }}-reviewer-buyer"
              type="checkbox"
              class="reviews-filter__input"
              name="reviewer"
              value="buyer"
              data-reviews-filter="reviewer"
            >
            <span>Verified buyers</span>
            <span class="reviews-filter__count">({{ facet_reviewer_buyer }})</span>
          </label>
        </li>
      {%- endif -%}
      {%- if facet_reviewer_recipient > 0 -%}
        <li class="reviews-filter__item">
          <label class="reviews-filter__label" for="{{ id_prefix }}-reviewer-recipient">
            <input
              id="{{ id_prefix }}-reviewer-recipient"
              type="checkbox"
              class="reviews-filter__input"
              name="reviewer"
              value="recipient"
              data-reviews-filter="reviewer"
            >
            <span>Gift recipients</span>
            <span class="reviews-filter__count">({{ facet_reviewer_recipient }})</span>
          </label>
        </li>
      {%- endif -%}
      {%- if facet_reviewer_gifter > 0 -%}
        <li class="reviews-filter__item">
          <label class="reviews-filter__label" for="{{ id_prefix }}-reviewer-gifter">
            <input
              id="{{ id_prefix }}-reviewer-gifter"
              type="checkbox"
              class="reviews-filter__input"
              name="reviewer"
              value="gifter"
              data-reviews-filter="reviewer"
            >
            <span>Gift givers</span>
            <span class="reviews-filter__count">({{ facet_reviewer_gifter }})</span>
          </label>
        </li>
      {%- endif -%}
      {%- if facet_reviewer_sample > 0 -%}
        <li class="reviews-filter__item">
          <label class="reviews-filter__label" for="{{ id_prefix }}-reviewer-sample">
            <input
              id="{{ id_prefix }}-reviewer-sample"
              type="checkbox"
              class="reviews-filter__input"
              name="reviewer"
              value="sample"
              data-reviews-filter="reviewer"
            >
            <span>Samples</span>
            <span class="reviews-filter__count">({{ facet_reviewer_sample }})</span>
          </label>
        </li>
      {%- endif -%}
    </ul>
  </details>
{%- endif -%}

{%- if facet_color_count > 0 -%}
  <details class="reviews-filter__details" data-reviews-filter-section="color" open>
    <summary class="reviews-filter__heading reviews-filter__summary">Color</summary>
    <ul class="reviews-filter__list reviews-filter__list--swatches list-unstyled" data-reviews-color-list>
      {{ color_rows }}
    </ul>
  </details>
{%- endif -%}

