    <summary class="reviews-filter__heading reviews-filter__summary">Owns</summary>
    <p class="reviews-filter__subtext">owns all selected</p>
    <ul class="reviews-filter__list list-unstyled">
      {{ owns_rows }}
    </ul>
  </details>
{%- endif -%}

