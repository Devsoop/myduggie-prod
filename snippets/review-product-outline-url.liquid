{%- doc -%}
  Resolve product outline_image URL for Owns row (metaobject product ref or catalog product).
  @param {object} product - product from review owns list or all_products
  @returns {string} outline_url|from_metafield via echo (pipe-delimited)
{%- enddoc -%}

{%- liquid
  assign outline_url = ''
  assign from_metafield = '0'
  assign catalog_product = product

  if product.handle != blank
    assign catalog_product = all_products[product.handle]
    if catalog_product == empty
      assign catalog_product = product
    endif
  endif

  assign outline_mf = catalog_product.metafields.custom.outline_image
  if outline_mf != blank
    assign from_metafield = '1'
    assign outline_url = outline_mf | file_url
    if outline_url == blank
      assign outline_file = outline_mf.value
      if outline_file != blank
        if outline_file.url != blank
          assign outline_url = outline_file.url
        else
          assign outline_url = outline_file | image_url: width: 128
        endif
      endif
    endif
  endif
-%}
{{- outline_url -}}|{{- from_metafield -}}
