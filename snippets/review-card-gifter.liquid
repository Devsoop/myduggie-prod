{%- doc -%}
  §5.8 Gifter Review Card — no usage qualifier, no Owns row; Gave row when gave[] populated.
{%- enddoc -%}

{%- liquid
  assign sample_label = sample_label | default: 'Sample'
  assign returns_label = returns_label | default: 'Order returned'
  assign photo_limit = photo_limit | default: 4 | plus: 0
  assign reviewer_pill_icon = reviewer_pill_icon | default: 'gift-giver'
  assign reviewer_pill_label = reviewer_pill_label | default: 'Gift giver'
  assign filterable = filterable | default: false
  assign reviewer_filter_value = reviewer_filter_value | default: 'gifter'
  assign display_name = ''
  assign reviewer_first = reviewer_first | strip
  assign reviewer_last = reviewer_last | strip
  if reviewer_first != blank and reviewer_last != blank
    assign last_initial = reviewer_last | slice: 0, 1 | upcase
    assign display_name = reviewer_first | append: ' ' | append: last_initial | append: '.'
  elsif reviewer_first != blank
    assign display_name = reviewer_first
  elsif reviewer_last != blank
    assign last_initial = reviewer_last | slice: 0, 1 | upcase
    assign display_name = last_initial | append: '.'
  endif
-%}

<article class="reviews-card reviews-card--gifter" data-review-id="{{ review_id }}">
  {%- if review_title != blank -%}
    <p class="reviews-card__title">{{ review_title | escape }}</p>
  {%- endif -%}
  <header class="reviews-card__header">
    <div class="reviews-card__header-left">
      {%- if display_name != blank -%}
        <span class="reviews-card__name">{{ display_name | escape }}</span>
      {%- endif -%}
      {% render 'review-stars-whole', rating: rating, filterable: filterable %}
    </div>
    {% render 'review-date', submitted_at: submitted_at %}
  </header>

  <div class="reviews-card__tags">
    {% render 'review-card-pill',
      label: reviewer_pill_label,
      icon: reviewer_pill_icon,
      filterable: filterable,
      filter_key: 'reviewer',
      filter_value: reviewer_filter_value
    %}
    {%- if is_sample -%}
      {% render 'review-card-pill',
        label: sample_label,
        filterable: filterable,
        filter_key: 'reviewer',
        filter_value: 'sample',
        filter_tooltip: 'Filter by samples'
      %}
    {%- endif -%}
    {%- if order_returned -%}
      <span class="reviews-card__returns">{{ returns_label }}</span>
    {%- endif -%}
  </div>

  {%- if gave_icon_count > 0 -%}
    <div class="reviews-card__gave">
      <p class="reviews-card__gave-label">Gave</p>
      <div class="reviews-card__gave-icons">
        {% render 'review-card-gave-icons', gave: gave, ownership: ownership, icon_limit: 12 %}
      </div>
    </div>
  {%- endif -%}

  <hr class="reviews-card__divider">

  {% render 'review-card-photos', photos: photos, photo_limit: photo_limit, gallery_id: review_id %}

  <div class="reviews-card__prose">
    {%- if prose_1_body != blank -%}
      <div class="reviews-card__prose-item">
        <p class="reviews-card__prompt">{{ prose_1_label | escape }}</p>
        <p class="reviews-card__body">{{ prose_1_body | escape }}</p>
      </div>
    {%- endif -%}
    {%- if prose_2_body != blank -%}
      <div class="reviews-card__prose-item">
        <p class="reviews-card__prompt">{{ prose_2_label | escape }}</p>
        <p class="reviews-card__body">{{ prose_2_body | escape }}</p>
      </div>
    {%- endif -%}
    {%- if prose_3_body != blank -%}
      <div class="reviews-card__prose-item">
        <p class="reviews-card__prompt">{{ prose_3_label | escape }}</p>
        <p class="reviews-card__body">{{ prose_3_body | escape }}</p>
      </div>
    {%- endif -%}
  </div>
</article>
