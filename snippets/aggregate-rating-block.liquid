{%- doc -%}
  §5.9 Aggregate Rating Block inner markup.
  Distribution: bar-chart fills only (normalized to max count). No track / progress-bar background.
  @param {number} average - e.g. 4.3
  @param {number} total_count
  @param {number} count_5 … count_1
  @param {string} [caption_prefix]
  @param {string} [unique_id]
  @param {boolean} [filterable] - M8: distribution bars filter by rating
{%- enddoc -%}

{%- assign unique_id = unique_id | default: 'aggregate-block' -%}

{%- liquid
  assign average = average | default: 0 | times: 1.0
  assign total_count = total_count | default: 0 | plus: 0
  assign count_5 = count_5 | default: 0 | plus: 0
  assign count_4 = count_4 | default: 0 | plus: 0
  assign count_3 = count_3 | default: 0 | plus: 0
  assign count_2 = count_2 | default: 0 | plus: 0
  assign count_1 = count_1 | default: 0 | plus: 0
  assign caption_prefix = caption_prefix | default: 'From'
  assign filterable = filterable | default: false

  assign max_count = count_5
  if count_4 > max_count
    assign max_count = count_4
  endif
  if count_3 > max_count
    assign max_count = count_3
  endif
  if count_2 > max_count
    assign max_count = count_2
  endif
  if count_1 > max_count
    assign max_count = count_1
  endif
  if max_count == 0
    assign max_count = 1
  endif

  assign pct_5 = count_5 | times: 100 | divided_by: max_count
  assign pct_4 = count_4 | times: 100 | divided_by: max_count
  assign pct_3 = count_3 | times: 100 | divided_by: max_count
  assign pct_2 = count_2 | times: 100 | divided_by: max_count
  assign pct_1 = count_1 | times: 100 | divided_by: max_count

  assign average_display = average | round: 1
-%}

<div class="reviews-aggregate__grid">
  <div class="reviews-aggregate__summary">
    <p class="reviews-aggregate__score">{{ average_display }}</p>
    {% render 'review-stars-aggregate', average: average_display, unique_id: unique_id %}
    <p class="reviews-aggregate__caption">
      {%- if total_count == 1 -%}
        {{ caption_prefix }} 1 review
      {%- else -%}
        {{ caption_prefix }} {{ total_count }} reviews
      {%- endif -%}
    </p>
  </div>

  <div class="reviews-aggregate__distribution" role="list">
    {%- if filterable and count_5 > 0 -%}
      <button type="button" class="reviews-aggregate__row reviews-aggregate__row--filterable reviews-card__filter-trigger" role="listitem" data-reviews-filter-trigger="rating" data-filter-value="5" data-filter-mode="replace" aria-label="Filter to 5 star reviews" aria-pressed="false">
        <span class="reviews-aggregate__row-label">5 ★</span>
        <div class="reviews-aggregate__bar-cell">
          <span class="reviews-aggregate__bar-fill" style="width: {{ pct_5 }}%;"></span>
        </div>
        <span class="reviews-aggregate__row-count">{{ count_5 }}</span>
      </button>
    {%- else -%}
      <div class="reviews-aggregate__row" role="listitem">
        <span class="reviews-aggregate__row-label">5 ★</span>
        <div class="reviews-aggregate__bar-cell">
          {%- if count_5 > 0 -%}
            <span class="reviews-aggregate__bar-fill" style="width: {{ pct_5 }}%;"></span>
          {%- endif -%}
        </div>
        <span class="reviews-aggregate__row-count">{{ count_5 }}</span>
      </div>
    {%- endif -%}

    {%- if filterable and count_4 > 0 -%}
      <button type="button" class="reviews-aggregate__row reviews-aggregate__row--filterable reviews-card__filter-trigger" role="listitem" data-reviews-filter-trigger="rating" data-filter-value="4" data-filter-mode="replace" aria-label="Filter to 4 star reviews" aria-pressed="false">
        <span class="reviews-aggregate__row-label">4 ★</span>
        <div class="reviews-aggregate__bar-cell">
          <span class="reviews-aggregate__bar-fill" style="width: {{ pct_4 }}%;"></span>
        </div>
        <span class="reviews-aggregate__row-count">{{ count_4 }}</span>
      </button>
    {%- else -%}
      <div class="reviews-aggregate__row" role="listitem">
        <span class="reviews-aggregate__row-label">4 ★</span>
        <div class="reviews-aggregate__bar-cell">
          {%- if count_4 > 0 -%}
            <span class="reviews-aggregate__bar-fill" style="width: {{ pct_4 }}%;"></span>
          {%- endif -%}
        </div>
        <span class="reviews-aggregate__row-count">{{ count_4 }}</span>
      </div>
    {%- endif -%}

    {%- if filterable and count_3 > 0 -%}
      <button type="button" class="reviews-aggregate__row reviews-aggregate__row--filterable reviews-card__filter-trigger" role="listitem" data-reviews-filter-trigger="rating" data-filter-value="3" data-filter-mode="replace" aria-label="Filter to 3 star reviews" aria-pressed="false">
        <span class="reviews-aggregate__row-label">3 ★</span>
        <div class="reviews-aggregate__bar-cell">
          <span class="reviews-aggregate__bar-fill" style="width: {{ pct_3 }}%;"></span>
        </div>
        <span class="reviews-aggregate__row-count">{{ count_3 }}</span>
      </button>
    {%- else -%}
      <div class="reviews-aggregate__row" role="listitem">
        <span class="reviews-aggregate__row-label">3 ★</span>
        <div class="reviews-aggregate__bar-cell">
          {%- if count_3 > 0 -%}
            <span class="reviews-aggregate__bar-fill" style="width: {{ pct_3 }}%;"></span>
          {%- endif -%}
        </div>
        <span class="reviews-aggregate__row-count">{{ count_3 }}</span>
      </div>
    {%- endif -%}

    {%- if filterable and count_2 > 0 -%}
      <button type="button" class="reviews-aggregate__row reviews-aggregate__row--filterable reviews-card__filter-trigger" role="listitem" data-reviews-filter-trigger="rating" data-filter-value="2" data-filter-mode="replace" aria-label="Filter to 2 star reviews" aria-pressed="false">
        <span class="reviews-aggregate__row-label">2 ★</span>
        <div class="reviews-aggregate__bar-cell">
          <span class="reviews-aggregate__bar-fill" style="width: {{ pct_2 }}%;"></span>
        </div>
        <span class="reviews-aggregate__row-count">{{ count_2 }}</span>
      </button>
    {%- else -%}
      <div class="reviews-aggregate__row" role="listitem">
        <span class="reviews-aggregate__row-label">2 ★</span>
        <div class="reviews-aggregate__bar-cell">
          {%- if count_2 > 0 -%}
            <span class="reviews-aggregate__bar-fill" style="width: {{ pct_2 }}%;"></span>
          {%- endif -%}
        </div>
        <span class="reviews-aggregate__row-count">{{ count_2 }}</span>
      </div>
    {%- endif -%}

    {%- if filterable and count_1 > 0 -%}
      <button type="button" class="reviews-aggregate__row reviews-aggregate__row--filterable reviews-card__filter-trigger" role="listitem" data-reviews-filter-trigger="rating" data-filter-value="1" data-filter-mode="replace" aria-label="Filter to 1 star reviews" aria-pressed="false">
        <span class="reviews-aggregate__row-label">1 ★</span>
        <div class="reviews-aggregate__bar-cell">
          <span class="reviews-aggregate__bar-fill" style="width: {{ pct_1 }}%;"></span>
        </div>
        <span class="reviews-aggregate__row-count">{{ count_1 }}</span>
      </button>
    {%- else -%}
      <div class="reviews-aggregate__row" role="listitem">
        <span class="reviews-aggregate__row-label">1 ★</span>
        <div class="reviews-aggregate__bar-cell">
          {%- if count_1 > 0 -%}
            <span class="reviews-aggregate__bar-fill" style="width: {{ pct_1 }}%;"></span>
          {%- endif -%}
        </div>
        <span class="reviews-aggregate__row-count">{{ count_1 }}</span>
      </div>
    {%- endif -%}
  </div>
</div>
