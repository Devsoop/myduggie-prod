{{ 'reviews-components.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reviews_heading = section.settings.heading
  assign initial_limit = section.settings.initial_limit | default: 10
  assign is_bundle_page = false
  if template.suffix == 'bundle' or template.suffix == 'the-pair' or template.suffix == 'the-complete-carry' or template.suffix == 'the-home-kit'
    assign is_bundle_page = true
  endif

  assign total_count = 0
  assign rating_sum = 0
  assign count_5 = 0
  assign count_4 = 0
  assign count_3 = 0
  assign count_2 = 0
  assign count_1 = 0
  assign scoped_reviews = ''

  for review_entry in shop.metaobjects.review.values
    if review_entry.status.value != 'approved'
      continue
    endif

    assign owns_products = review_entry.owns.value
    assign product_found = false
    if owns_products != blank
      for owned_product in owns_products
        if owned_product.id == product.id
          assign product_found = true
          break
        endif
      endfor
    endif
    if product_found == false
      continue
    endif

    assign total_count = total_count | plus: 1
    assign r = review_entry.rating.value | plus: 0
    assign rating_sum = rating_sum | plus: r
    if r == 5
      assign count_5 = count_5 | plus: 1
    elsif r == 4
      assign count_4 = count_4 | plus: 1
    elsif r == 3
      assign count_3 = count_3 | plus: 1
    elsif r == 2
      assign count_2 = count_2 | plus: 1
    elsif r == 1
      assign count_1 = count_1 | plus: 1
    endif

    if scoped_reviews == ''
      assign scoped_reviews = review_entry.system.handle
    else
      assign scoped_reviews = scoped_reviews | append: ',' | append: review_entry.system.handle
    endif
  endfor

  assign average = 0
  if total_count > 0
    assign average = rating_sum | times: 1.0 | divided_by: total_count
  endif

  assign scoped_handles = scoped_reviews | split: ','
-%}

{% if total_count > 0 or request.visual_preview_mode %}
  <section
    class="pdp-reviews reviews-surface color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="pdp-reviews__inner{% if is_bundle_page %} pdp-reviews__inner--wide{% endif %}">
      {% if reviews_heading != blank %}
        <h2 class="pdp-reviews__heading">{{ reviews_heading | escape }}</h2>
      {% endif %}

      {%- comment -%} 1. Aggregate rating block {%- endcomment -%}
      <div class="reviews-aggregate">
        {% render 'aggregate-rating-block',
          average: average,
          total_count: total_count,
          count_5: count_5,
          count_4: count_4,
          count_3: count_3,
          count_2: count_2,
          count_1: count_1,
          caption_prefix: 'From',
          unique_id: section.id
        %}
      </div>

      {%- comment -%} 2. FTC disclosure {%- endcomment -%}
      <div class="pdp-reviews__ftc">
        {{ section.settings.ftc_disclosure }}
      </div>

      {%- comment -%} 3. Filter sidebar + review cards {%- endcomment -%}
      <div class="pdp-reviews__body">
        <aside class="pdp-reviews__filters" data-reviews-filters>
          <div class="pdp-reviews__filter-group">
            <h3 class="pdp-reviews__filter-heading">Reviewer</h3>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Verified buyers</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Gift recipients</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Gift givers</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Samples</label>
          </div>

          <div class="pdp-reviews__filter-group">
            <h3 class="pdp-reviews__filter-heading">Color</h3>
            <div class="pdp-reviews__filter-swatches">
              {%- comment -%} Color swatches — stubbed, populated when filter logic ships {%- endcomment -%}
            </div>
          </div>

          <div class="pdp-reviews__filter-group">
            <h3 class="pdp-reviews__filter-heading">Rating</h3>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> 5 stars</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> 4 stars</label>
          </div>

          {%- unless is_bundle_page -%}
            <div class="pdp-reviews__filter-group">
              <h3 class="pdp-reviews__filter-heading">Owns</h3>
              <p class="pdp-reviews__filter-hint">Show reviewers who own all selected</p>
              <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Lil' Duggie</label>
              <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Keychain</label>
              <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Pipe</label>
            </div>
          {%- endunless -%}

          <div class="pdp-reviews__filter-group">
            <h3 class="pdp-reviews__filter-heading">How it was bought</h3>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> Bought on its own</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> The Pair</label>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> The Complete Carry</label>
          </div>

          <div class="pdp-reviews__filter-group">
            <h3 class="pdp-reviews__filter-heading">Photos</h3>
            <label class="pdp-reviews__filter-option"><input type="checkbox" disabled> With photos</label>
          </div>
        </aside>

        <div class="reviews-cards" data-reviews-cards>
          {%- assign cards_rendered = 0 -%}
          {%- for review_entry in shop.metaobjects.review.values -%}
            {%- if review_entry.status.value != 'approved' -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign owns_products = review_entry.owns.value -%}
            {%- assign product_found = false -%}
            {%- if owns_products != blank -%}
              {%- for owned_product in owns_products -%}
                {%- if owned_product.id == product.id -%}
                  {%- assign product_found = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if product_found == false -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign cards_rendered = cards_rendered | plus: 1 -%}
            <div class="pdp-reviews__card-wrapper{% if cards_rendered > initial_limit %} pdp-reviews__card-wrapper--hidden{% endif %}">
                {% render 'review-buyer-card-from-metaobject',
                review_entry: review_entry,
                verified_buyer_label: 'Verified buyer',
                sample_label: 'Sample',
                returns_label: 'Order returned',
                photo_limit: 4
              %}
            </div>
          {%- endfor -%}

          {%- if cards_rendered > initial_limit -%}
            <button type="button" class="pdp-reviews__load-more" data-reviews-load-more>
              Show more reviews
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .pdp-reviews__inner {
    width: min(840px, calc(100vw - (2 * var(--page-margin, 24px))));
    margin-inline: auto;
    margin-bottom: 48px;
  }

  .pdp-reviews__inner--wide {
    width: min(50rem, calc(100vw - (2 * var(--page-margin, 24px))));
    padding-inline: clamp(2rem, 5vw, 3rem);
  }

  .pdp-reviews__heading {
    margin: 0 0 24px;
    font-size: var(--font-h4--size);
    line-height: var(--font-h4--line-height);
    text-align: center;
  }

  /* FTC disclosure */
  .pdp-reviews__ftc {
    margin: 0 0 32px;
    font-family: var(--brand-font-serif-italic, Georgia, serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.6;
    color: var(--reviews-text-secondary, #5F5E5A);
  }

  .pdp-reviews__ftc:empty {
    display: none;
  }

  /* Filter + cards layout */
  .pdp-reviews__body {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 32px;
  }

  /* Filter sidebar */
  .pdp-reviews__filters {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pdp-reviews__filter-heading {
    font-size: 13px;
    font-weight: 600;
    color: var(--reviews-text-primary, #1f1f1e);
    margin: 0 0 8px;
  }

  .pdp-reviews__filter-hint {
    font-size: 11px;
    color: var(--reviews-text-tertiary, #888780);
    margin: 0 0 6px;
  }

  .pdp-reviews__filter-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--reviews-text-primary, #1f1f1e);
    cursor: not-allowed;
    opacity: 0.5;
    margin-bottom: 4px;
  }

  .pdp-reviews__filter-option input {
    margin: 0;
  }

  .pdp-reviews__filter-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 24px;
  }

  .pdp-reviews__filter-group {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--reviews-border-tertiary, rgba(0,0,0,0.12));
  }

  .pdp-reviews__filter-group:last-child {
    border-bottom: none;
  }

  /* Load more */
  .pdp-reviews__card-wrapper--hidden {
    display: none;
  }

  .pdp-reviews__load-more {
    display: block;
    width: 100%;
    margin-top: 16px;
    padding: 12px 20px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--reviews-text-primary, #1f1f1e);
    background: transparent;
    border: 1px solid var(--reviews-border-tertiary, rgba(0,0,0,0.12));
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .pdp-reviews__load-more:hover {
    background: var(--reviews-bg-pill, #f4f4f2);
  }

  /* Mobile: filters in drawer (stubbed as hidden for now) */
  @media screen and (max-width: 749px) {
    .pdp-reviews__body {
      grid-template-columns: 1fr;
    }

    .pdp-reviews__filters {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const loadMoreBtn = document.querySelector('[data-reviews-load-more]');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      const hidden = document.querySelectorAll('.pdp-reviews__card-wrapper--hidden');
      hidden.forEach(el => el.classList.remove('pdp-reviews__card-wrapper--hidden'));
      loadMoreBtn.remove();
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PDP reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "richtext",
      "id": "ftc_disclosure",
      "label": "FTC disclosure",
      "default": "<p><em>From the people who have one. For the people thinking about one.</em></p><p><em>Every review here is from someone who bought one, was sent one as a gift, or gave one as a gift. We email and ask. If they write, we publish — first name and last initial, exactly what they wrote. Reviews from people we sent a free unit to are tagged \"Sample.\"</em></p><p><em>What they loved. What they'd change. Everything in between.</em></p>"
    },
    {
      "type": "range",
      "id": "initial_limit",
      "label": "Reviews shown before load more",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "PDP reviews"
    }
  ]
}
{% endschema %}
