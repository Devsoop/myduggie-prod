{% javascript %}
  const heroMobileMq = window.matchMedia('(max-width: 749px)');

  function loadHeroViewportVideo(video) {
    if (video.dataset.heroVideoLoaded) return;

    const sources = JSON.parse(video.dataset.heroVideoSources);
    sources.forEach(({ url, type }) => {
      const source = document.createElement('source');
      source.src = url;
      source.type = type;
      video.appendChild(source);
    });

    video.preload = 'auto';
    video.load();
    video.play().catch(() => {});
    video.dataset.heroVideoLoaded = 'true';

    // Seamless loop, HLS-safe: handled by the shared dual-buffer implementation
    // in snippets/video.liquid (avoids the segment re-fetch stutter a plain
    // seek-to-0 causes on .m3u8 streams).
    if (typeof applyDualBufferLoop === 'function') {
      applyDualBufferLoop(video);
    }
  }

  function shouldLoadHeroVideo(video, isMobile, hasMobileSpecificMedia) {
    if (!hasMobileSpecificMedia) return true;

    const viewport = video.dataset.heroVideoViewport;
    if (!viewport) return true;
    if (isMobile) return viewport === 'mobile';
    return viewport === 'desktop';
  }

  function removeHeroVideoElement(video) {
    video.pause();
    video.removeAttribute('src');
    video.querySelectorAll('source').forEach((source) => source.remove());
    const wrapper = video.closest('.hero__media-wrapper');
    if (wrapper) {
      wrapper.remove();
    } else {
      video.remove();
    }
  }

  function initHeroViewportVideos(hero) {
    const isMobile = heroMobileMq.matches;
    const hasMobileSpecificMedia = hero.dataset.heroHasMobileSpecificMedia === 'true';
    const hasMobileMedia = hero.dataset.heroHasMobileMedia === 'true';
    const desktopOnly = hero.querySelectorAll(
      '.hero__media-wrapper--desktop:not(.hero__media-wrapper--mobile)'
    );
    const mobileOnly = hero.querySelectorAll(
      '.hero__media-wrapper--mobile:not(.hero__media-wrapper--desktop)'
    );

    if (isMobile && !hasMobileMedia) {
      desktopOnly.forEach((wrapper) => wrapper.remove());
      hero.querySelectorAll('video[data-hero-video-viewport="desktop"]').forEach((video) => {
        removeHeroVideoElement(video);
      });
      return;
    }

    if (isMobile && hasMobileSpecificMedia) {
      desktopOnly.forEach((wrapper) => wrapper.remove());
    } else if (!isMobile && hasMobileSpecificMedia) {
      mobileOnly.forEach((wrapper) => wrapper.remove());
    }

    hero.querySelectorAll('video[data-hero-video-viewport]').forEach((video) => {
      if (hasMobileSpecificMedia && !shouldLoadHeroVideo(video, isMobile, hasMobileSpecificMedia)) {
        removeHeroVideoElement(video);
      }
    });

    hero.querySelectorAll('[data-hero-video-sources]').forEach((video) => {
      if (shouldLoadHeroVideo(video, isMobile, hasMobileSpecificMedia)) {
        loadHeroViewportVideo(video);
      }
    });
  }

  function initAllHeroViewportVideos() {
    document.querySelectorAll('.hero').forEach(initHeroViewportVideos);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllHeroViewportVideos);
  } else {
    initAllHeroViewportVideos();
  }
