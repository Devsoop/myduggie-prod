

{% liquid
  assign media_count = 0
  assign media_count_mobile = 0
  assign fallback_to_desktop = false
  assign media_1 = 'none'
  assign media_2 = 'none'
  assign media_1_mobile = 'none'
  assign media_2_mobile = 'none'
  assign has_only_video = false
  assign has_only_video_mobile = false
  assign video_1 = section.settings.video_1
  assign video_1_mobile = section.settings.video_1_mobile
  assign video_2 = section.settings.video_2
  assign video_2_mobile = section.settings.video_2_mobile
  assign uses_external_video_source = false

  if request.page_type == 'product' and section.settings.product_video_source == 'hero'
    assign video_1 = product.metafields.custom.hero_video_desktop.value
    assign video_1_mobile = product.metafields.custom.hero_video_mobile.value
    assign uses_external_video_source = true
  elsif request.page_type == 'product' and section.settings.product_video_source == 'turntable'
    assign video_1 = product.metafields.custom.turntable_video_desktop.value
    assign video_1_mobile = product.metafields.custom.turntable_video_mobile.value
    assign uses_external_video_source = true
  elsif request.page_type == 'page' and section.settings.product_video_source == 'page_hero'
    assign video_1 = page.metafields.custom.hero_video_desktop.value
    assign video_1_mobile = page.metafields.custom.hero_video_mobile.value
    assign uses_external_video_source = true
  endif

  assign uses_pdp_video_sizing = uses_external_video_source
  assign uses_landing_section_video = false
  if section.settings.media_type_1 == 'video' and video_1 != blank
    assign uses_pdp_video_sizing = true
    if request.page_type == 'page'
      assign uses_landing_section_video = true
    endif
  endif

  # Desktop media checks
  # For each media slot, check if the media is not blank and the media type matches the slot
  # Need to check both (1) media picker is not blank AND (2) section.setting.media_type because user can toggle between different media types to display, but choosing "Image" doesn't clear a saved "Video" in the theme editor.
  # The alternate setting (section.settings.image_1 when "Video" is selected) is only visually hidden in theme editor.
  if section.settings.image_1 != blank and section.settings.media_type_1 == 'image'
    assign media_1 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if video_1 != blank
    if section.settings.media_type_1 == 'video' or uses_external_video_source
      assign media_1 = 'video'
      assign media_count = media_count | plus: 1
    endif
  endif
  if section.settings.image_2 != blank and section.settings.media_type_2 == 'image'
    assign media_2 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if video_2 != blank and section.settings.media_type_2 == 'video'
    assign media_2 = 'video'
    assign media_count = media_count | plus: 1
  endif

  if section.settings.custom_mobile_media or uses_external_video_source
    # Mobile media checks
    # For each media slot, check if the media is not blank and the media type matches the slot
    if section.settings.image_1_mobile != blank and section.settings.media_type_1_mobile == 'image'
      assign media_1_mobile = 'image'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
    if video_1_mobile != blank
      if section.settings.media_type_1_mobile == 'video' or uses_external_video_source
        assign media_1_mobile = 'video'
        assign media_count_mobile = media_count_mobile | plus: 1
      endif
    endif
    if section.settings.image_2_mobile != blank and section.settings.media_type_2_mobile == 'image'
      assign media_2_mobile = 'image'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
    if video_2_mobile != blank and section.settings.media_type_2_mobile == 'video'
      assign media_2_mobile = 'video'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
  endif
  assign mobile_media_count_raw = media_count_mobile
  if media_count > 0 and media_1 != 'image' and media_2 != 'image'
    assign has_only_video = true
  endif
  if mobile_media_count_raw > 0 and media_1_mobile != 'image' and media_2_mobile != 'image'
    assign has_only_video_mobile = true
  endif

  assign has_mobile_specific_media = false
  if section.settings.custom_mobile_media and mobile_media_count_raw > 0
    assign has_mobile_specific_media = true
  endif
  if uses_external_video_source and mobile_media_count_raw > 0
    assign has_mobile_specific_media = true
  endif

  # If custom mobile media is disabled or no mobile media is present, we may fallback to desktop media.
  # PDP metafield heroes never fallback: no mobile metafield means no hero on mobile.
  if section.settings.custom_mobile_media == false
    unless has_mobile_specific_media
      unless uses_external_video_source
        assign media_count_mobile = media_count
        assign fallback_to_desktop = true
      endunless
    endunless
  elsif mobile_media_count_raw == 0 and media_count > 0
    unless uses_external_video_source
      assign media_count_mobile = media_count
      assign fallback_to_desktop = true
    endunless
  endif

  assign media_wrapper_desktop_class = 'hero__media-wrapper hero__media-wrapper--desktop'
  assign media_wrapper_mobile_class = 'hero__media-wrapper hero__media-wrapper--mobile'
  # Share desktop media on mobile only when falling back to desktop (not for PDP metafield heroes).
  if fallback_to_desktop
    assign media_wrapper_desktop_class = media_wrapper_desktop_class | append: ' hero__media-wrapper--mobile'
  endif

  # Should we show the blurred reflection on mobile?
  assign show_mobile_blurred_reflection = false
  if section.settings.blurred_reflection
    if section.settings.custom_mobile_media == true and media_count_mobile > 0 and has_only_video_mobile == false
      # Custom mobile media is active and a mobile image is present
      assign show_mobile_blurred_reflection = true
    elsif section.settings.custom_mobile_media == true and media_count_mobile == 0 and media_count > 0 and has_only_video == false
      # Custom mobile media is active, no mobile media is present, but a desktop image is present
      assign show_mobile_blurred_reflection = true
    elsif section.settings.custom_mobile_media == false and media_count > 0 and has_only_video == false
      # Custom mobile media is inactive, but a desktop image is present
      assign show_mobile_blurred_reflection = true
    endif
  endif

  if media_1 == 'image' and media_2 == 'image'
    assign media_width_desktop = '50vw'
  else
    assign media_width_desktop = '100vw'
  endif

  assign show_media_placeholder = false
  if media_count == 0 and mobile_media_count_raw == 0
    assign show_media_placeholder = true
  endif

  assign slot_1_dual_viewport_video = false
  if media_1 == 'video' and media_1_mobile == 'video'
    assign slot_1_dual_viewport_video = true
  endif
  assign slot_1_defer_desktop_video = slot_1_dual_viewport_video
  assign slot_1_defer_mobile_video = slot_1_dual_viewport_video

  assign slot_2_dual_viewport_video = false
  if media_2 == 'video' and media_2_mobile == 'video'
    assign slot_2_dual_viewport_video = true
  endif
  assign slot_2_defer_desktop_video = slot_2_dual_viewport_video
  assign slot_2_defer_mobile_video = slot_2_dual_viewport_video

  assign has_desktop_hero_media = false
  if media_count > 0
    assign has_desktop_hero_media = true
  endif

  assign has_mobile_hero_media = false
  if fallback_to_desktop
    if media_count > 0
      assign has_mobile_hero_media = true
    endif
  elsif mobile_media_count_raw > 0
    assign has_mobile_hero_media = true
  endif

  if fallback_to_desktop
    assign media_width_mobile = media_width_desktop
  elsif section.settings.stack_media_on_mobile or media_1_mobile != 'image' or media_2_mobile != 'image'
    assign media_width_mobile = '100vw'
  else
    assign media_width_mobile = '50vw'
  endif

  assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
  assign sizes_mobile = media_width_mobile
  assign mobile_widths = '416, 600, 800, 1200, 1600'
  assign mobile_widths_array = mobile_widths | split: ', '

  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign render_direct_pdp_video = false
  if uses_pdp_video_sizing
    assign render_direct_pdp_video = true
  endif

  assign hero_display_desktop = section.settings.video_display_behavior_desktop | default: 'full_width'
  assign hero_display_mobile = section.settings.video_display_behavior_mobile | default: 'full_width'

  if request.page_type == 'product'
    if section.settings.product_video_source == 'hero'
      if product.metafields.custom.hero_video_display_mode.value != blank
        assign hero_display_desktop = product.metafields.custom.hero_video_display_mode.value
      endif
      if product.metafields.custom.hero_video_display_mode_mobile.value != blank
        assign hero_display_mobile = product.metafields.custom.hero_video_display_mode_mobile.value
      endif
    endif
  elsif request.page_type == 'page'
    if section.settings.product_video_source == 'page_hero'
      if page.metafields.custom.hero_video_display_mode.value != blank
        assign hero_display_desktop = page.metafields.custom.hero_video_display_mode.value
      endif
      if page.metafields.custom.hero_video_display_mode_mobile.value != blank
        assign hero_display_mobile = page.metafields.custom.hero_video_display_mode_mobile.value
      endif
    endif
  endif

  assign hero_display_desktop = hero_display_desktop | downcase | strip
  assign hero_display_mobile = hero_display_mobile | downcase | strip
  if hero_display_desktop contains 'height' or hero_display_desktop contains 'hight'
    assign hero_display_desktop = 'full_height'
  elsif hero_display_desktop contains 'width' or hero_display_desktop contains 'natural'
    assign hero_display_desktop = 'full_width'
  elsif hero_display_desktop == 'fill' or hero_display_desktop contains 'fill'
    assign hero_display_desktop = 'full_height'
  elsif hero_display_desktop contains 'constrained'
    assign hero_display_desktop = 'full_width'
  else
    assign hero_display_desktop = 'full_width'
  endif
  if hero_display_mobile contains 'height' or hero_display_mobile contains 'hight'
    assign hero_display_mobile = 'full_height'
  elsif hero_display_mobile contains 'width' or hero_display_mobile contains 'natural'
    assign hero_display_mobile = 'full_width'
  elsif hero_display_mobile == 'fill' or hero_display_mobile contains 'fill'
    assign hero_display_mobile = 'full_height'
  elsif hero_display_mobile contains 'constrained'
    assign hero_display_mobile = 'full_width'
  else
    assign hero_display_mobile = 'full_width'
  endif
%}

{% capture media_slot_1 %}
  {%- if media_1 == 'image' and media_1_mobile == 'image' -%}
    {%- comment -%} Both desktop and mobile are images. Assume similar images, and this is art direction: use picture element. {%- endcomment -%}
    <picture
      data-testid="hero-picture-1"
      class="hero__media"
    >
      <source
        media="(max-width: 749px)"
        srcset="
          {%-  for mobile_width in mobile_widths_array -%}
            {{ section.settings.image_1_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        "
        sizes="{{ sizes_mobile }}"
        width="{{ section.settings.image_1_mobile.width }}"
        height="{{ section.settings.image_1_mobile.height }}"
      >
      {{
        section.settings.image_1
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_1.width,
          widths: widths,
          height: section.settings.image_1.height,
          alt: section.settings.image_1.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-1'
      }}
    </picture>
  {%- elsif media_1 == 'image' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.image_1
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_1.width,
          widths: widths,
          height: section.settings.image_1.height,
          alt: section.settings.image_1.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-1'
      }}
    </div>
  {%- endif -%}

  {%- if media_1 == 'video' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {% render 'video',
        video: video_1,
        video_autoplay: true,
        video_loop: true,
        disable_controls: true,
        video_class: 'hero__media',
        render_direct_video: render_direct_pdp_video,
        defer_viewport_sources: slot_1_defer_desktop_video,
        additional_attributes: 'data-testid="hero-desktop-video-1" data-hero-video-viewport="desktop"'
      %}
    </div>
  {%- endif -%}

  {%- if has_mobile_specific_media -%}
    {%- comment -%} Mobile-only slot 1 media (when desktop is different type) {%- endcomment -%}
    {%- if media_1_mobile == 'image' and media_1 != 'image' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag:
            width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: section.settings.image_1_mobile.alt,
            class: 'hero__media',
            sizes: sizes_mobile,
            fetchpriority: fetch_priority,
            data-testid: 'hero-mobile-image-1'
        }}
      </div>
    {%- endif -%}

    {%- if media_1_mobile == 'video' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {% render 'video',
          video: video_1_mobile,
          video_autoplay: true,
          video_loop: true,
          disable_controls: true,
          video_class: 'hero__media',
          render_direct_video: render_direct_pdp_video,
          defer_viewport_sources: slot_1_defer_mobile_video,
          additional_attributes: 'data-testid="hero-mobile-video-1" data-hero-video-viewport="mobile"'
        %}
      </div>
    {%- endif -%}
  {%- endif -%}
{% endcapture %}

{% capture media_slot_2 %}
  {%- if media_2 == 'image' and media_2_mobile == 'image' -%}
    {%- comment -%} Both desktop and mobile are images. Assume this is art direction: use picture element.  {%- endcomment -%}
    <picture
      class="hero__media"
      data-testid="hero-picture-2"
    >
      <source
        media="(max-width: 749px)"
        srcset="
          {%-  for mobile_width in mobile_widths_array -%}
            {{ section.settings.image_2_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last%},{% endunless %}
          {%- endfor -%}
        "
        sizes="{{ sizes_mobile }}"
        width="{{ section.settings.image_2_mobile.width }}"
        height="{{ section.settings.image_2_mobile.height }}"
      >
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          widths: widths,
          height: section.settings.image_2.height,
          alt: section.settings.image_2.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-2'
      }}
    </picture>
  {%- elsif media_2 == 'image' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          widths: widths,
          height: section.settings.image_2.height,
          alt: section.settings.image_2.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-2'
      }}
    </div>
  {%- endif -%}

  {%- if media_2 == 'video' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {% render 'video',
        video: video_2,
        video_autoplay: true,
        video_loop: true,
        disable_controls: true,
        video_class: 'hero__media',
        render_direct_video: render_direct_pdp_video,
        defer_viewport_sources: slot_2_defer_desktop_video,
        additional_attributes: 'data-testid="hero-desktop-video-2" data-hero-video-viewport="desktop"'
      %}
    </div>
  {%- endif -%}

  {%- comment -%} Mobile-only slot 2 media (when desktop is different type) {%- endcomment -%}
  {%- if has_mobile_specific_media -%}
    {%- if media_2_mobile == 'image' and media_2 != 'image' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag:
            width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: section.settings.image_2_mobile.alt,
            class: 'hero__media',
            sizes: sizes_mobile,
            fetchpriority: fetch_priority,
            data-testid: 'hero-mobile-image-2'
        }}
      </div>
    {%- endif -%}

    {%- if media_2_mobile == 'video' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {% render 'video',
          video: video_2_mobile,
          video_autoplay: true,
          video_loop: true,
          disable_controls: true,
          video_class: 'hero__media',
          render_direct_video: render_direct_pdp_video,
          defer_viewport_sources: slot_2_defer_mobile_video,
          additional_attributes: 'data-testid="hero-mobile-video-2" data-hero-video-viewport="mobile"'
        %}
      </div>
    {%- endif -%}
  {%- endif -%}
{% endcapture %}

{% capture media %}
  {{ media_slot_1 }}
  {{ media_slot_2 }}

  {% if show_media_placeholder %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
  {%- endif -%}
{% endcapture %}

{% capture media_blurred %}
  {% if media_1 == 'image' %}
    {{
      section.settings.image_1
      | image_url: width: 3840
      | image_tag:
        width: section.settings.image_1.width,
        widths: widths,
        height: section.settings.image_1.height,
        alt: '',
        class: 'hero__media',
        sizes: sizes
    }}
  {% endif %}
  {% if media_2 == 'image' %}
    {{
      section.settings.image_2
      | image_url: width: 3840
      | image_tag:
        width: section.settings.image_2.width,
        widths: widths,
        height: section.settings.image_2.height,
        alt: '',
        class: 'hero__media',
        sizes: sizes
    }}
  {% endif %}
  {% if show_media_placeholder %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
  {% endif %}
{% endcapture %}

{% capture mobile_media_blurred %}
  {%- comment -%}
    On mobile we need to check:
    1. If the media should be stacked. If it is,we check for the second (bottom) image first, then for the first (top) image.
    2. If custom mobile setting is active and has media (show desktop media otherwise).
  {%- endcomment -%}
  {% if section.settings.stack_media_on_mobile == false %}
    {% if section.settings.custom_mobile_media == true and fallback_to_desktop == false %}
      {% if media_1_mobile == 'image' %}
        {{ section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
      {% if media_2_mobile == 'image' %}
        {{ section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
    {% elsif fallback_to_desktop %}
      {{ media_blurred }}
    {% endif %}
  {% elsif section.settings.stack_media_on_mobile == true %}
    {% if section.settings.custom_mobile_media == true and fallback_to_desktop == false %}
      {% if media_2_mobile == 'image' %}
        {{ section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
        }}
      {% elsif media_1_mobile == 'image' %}
        {{ section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
    {% elsif fallback_to_desktop %}
      {% if media_count > 0 %}
        {% if media_2 == 'image' %}
          {{ section.settings.image_2
            | image_url: width: 1600
            | image_tag: width: section.settings.image_2.width,
              widths: widths,
              height: section.settings.image_2.height,
              alt: '',
              class: 'hero__media',
              sizes: sizes
            }}
        {% elsif media_1 == 'image' %}
          {{ section.settings.image_1
            | image_url: width: 1600
            | image_tag: width: section.settings.image_1.width,
              widths: widths,
              height: section.settings.image_1.height,
              alt: '',
              class: 'hero__media',
              sizes: sizes
            }}
        {% endif %}
        {% if show_media_placeholder %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endcapture %}

{% liquid
  assign has_any_hero_media = false
  if has_desktop_hero_media or has_mobile_hero_media
    assign has_any_hero_media = true
  endif
%}
{% if has_any_hero_media %}
<div
  id="Hero-{{ section.id }}"
  class="hero color-{{ section.settings.color_scheme }}{% if uses_pdp_video_sizing %} hero--pdp-video{% endif %}{% if uses_landing_section_video %} hero--landing-section-video{% endif %}{% if section.blocks.size == 0 and section.settings.section_height == 'auto' %} hero--no-blocks-auto-height{% endif %}{% if section.settings.stack_media_on_mobile %} hero--stack-mobile{% endif %}"
  data-hero-display-desktop="{{ hero_display_desktop }}"
  data-hero-display-mobile="{{ hero_display_mobile }}"
  data-hero-has-desktop-media="{% if has_desktop_hero_media %}true{% else %}false{% endif %}"
  data-hero-has-mobile-media="{% if has_mobile_hero_media %}true{% else %}false{% endif %}"
  data-hero-has-mobile-specific-media="{% if has_mobile_specific_media %}true{% else %}false{% endif %}"
  style="
    --hero-border-style: {{ section.settings.border }};
    --hero-border-width: {{ section.settings.border_width }}px;
    --hero-border-opacity: {{ section.settings.border_opacity }}%;
    --blur-opacity: {{ section.settings.reflection_opacity | divided_by: 100.0 }};
    {% if section.settings.section_height == 'custom' %}
      --hero-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == "full-screen" %}
       --hero-min-height: 100svh;
    {% else %}
      --hero-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
    {%- if uses_pdp_video_sizing -%}
      --hero-available-width: 100vw;
      {%- if video_1_mobile.preview_image != blank -%}
        --hero-media-aspect-ratio-mobile: {{ video_1_mobile.preview_image.aspect_ratio }};
      {%- elsif video_1_mobile != blank -%}
        --hero-media-aspect-ratio-mobile: 0.5625;
      {%- elsif video_1 != blank -%}
        --hero-media-aspect-ratio-mobile: {{ video_1.aspect_ratio | default: 1.777 }};
      {%- endif -%}
    {%- endif -%}
  "
  {% if template.suffix == 'standard-pdp' and section.settings.product_video_source != 'none' %}
    data-hero-auto-hide
  {% elsif has_only_video %}
    data-hero-auto-hide
  {% elsif has_only_video_mobile %}
    data-hero-auto-hide
  {% endif %}
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  {% if section.settings.blurred_reflection and has_only_video == false or has_only_video_mobile == false %}
    data-blur-shadow="true"
  {% endif %}
>
  {% if section.settings.blurred_reflection %}
    {% unless has_only_video %}
      <div
        class="hero__blurred-image hero__blurred-image--desktop"
        data-testid="hero-blurred-image-desktop"
      >
        {{ media_blurred }}
      </div>
    {% endunless %}
    {% if show_mobile_blurred_reflection %}
      <div
        class="hero__blurred-image hero__blurred-image--mobile"
        data-testid="hero-blurred-image-mobile"
      >
        {{ mobile_media_blurred }}
      </div>
    {% endif %}
  {% endif %}

  {% comment %}
    Hardcoded to section--full-width bc the media has to be full width in all cases.
    hero__content-wrapper applies section_width.
  {% endcomment %}

  <div
    class="hero__container spacing-style section section--full-width"
    style="{% render 'spacing-style', settings: section.settings %} --padding-block-start: 0px;"
  >
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="hero__link"
        {% if section.settings.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      ></a>
    {%- endif -%}
    <div
      class="hero__media-grid"
      style="
        --hero-media-count: {{ media_count }};
        --hero-media-count-mobile: {{ media_count_mobile }};
        {%- if section.settings.media_type_1 == 'video' -%}
          {%- if video_1.preview_image != blank -%}
            --hero-media-aspect-ratio: {{ video_1.preview_image.aspect_ratio }};
          {%- elsif video_1 != blank -%}
            --hero-media-aspect-ratio: {{ video_1.aspect_ratio | default: 1.777 }};
          {%- endif -%}
        {%- elsif section.settings.image_1 != blank -%}
          --hero-media-aspect-ratio: {{ section.settings.image_1.aspect_ratio }};
        {%- endif -%}
        {%- if section.settings.media_type_1_mobile == 'video' -%}
          {%- if video_1_mobile.preview_image != blank -%}
            --hero-media-aspect-ratio-mobile: {{ video_1_mobile.preview_image.aspect_ratio }};
          {%- elsif video_1_mobile != blank -%}
            --hero-media-aspect-ratio-mobile: 0.5625;
          {%- endif -%}
        {%- elsif section.settings.image_1_mobile != blank -%}
          --hero-media-aspect-ratio-mobile: {{ section.settings.image_1_mobile.aspect_ratio }};
        {%- endif -%}
      "
      data-testid="hero-media-wrapper"
    >
      {% liquid
        if section.settings.toggle_overlay
          render 'overlay', settings: section.settings
        endif
      %}
      {%- if has_mobile_specific_media -%}
        <style>
          @media screen and (max-width: 749px) {
            #Hero-{{ section.id }} .hero__media-wrapper--desktop:not(.hero__media-wrapper--mobile),
            #Hero-{{ section.id }} video[data-hero-video-viewport='desktop'] {
              display: none !important;
              visibility: hidden !important;
              height: 0 !important;
              max-height: 0 !important;
              overflow: hidden !important;
              pointer-events: none !important;
            }
          }
          @media screen and (min-width: 750px) {
            #Hero-{{ section.id }} .hero__media-wrapper--mobile:not(.hero__media-wrapper--desktop),
            #Hero-{{ section.id }} video[data-hero-video-viewport='mobile'] {
              display: none !important;
              visibility: hidden !important;
              height: 0 !important;
              max-height: 0 !important;
              overflow: hidden !important;
              pointer-events: none !important;
            }
          }
        </style>
      {%- endif -%}
      {{ media }}
      {%- if has_mobile_specific_media -%}
        <script>
          (function () {
            if (!window.matchMedia('(max-width: 749px)').matches) return;
            var hero = document.currentScript && document.currentScript.closest('.hero');
            if (!hero) return;
            hero
              .querySelectorAll('.hero__media-wrapper--desktop:not(.hero__media-wrapper--mobile)')
              .forEach(function (wrapper) {
                wrapper.remove();
              });
            hero.querySelectorAll('video[data-hero-video-viewport="desktop"]').forEach(function (video) {
              video.pause();
              video.querySelectorAll('source').forEach(function (source) {
                source.remove();
              });
              video.remove();
            });
          })();
        </script>
      {%- endif -%}
    </div>
    <div
      class="
        hero__content-wrapper
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        {% if section.settings.vertical_on_mobile %}mobile-column{% endif %}
        section-content-wrapper
        {{section.settings.section_width}}
        {% if request.design_mode %}hero__content-wrapper--design-mode{% endif %}
      "
      style="{% render 'layout-panel-style', settings: section.settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% endif %}

{% stylesheet %}
