{{ 'reviews-components.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign caption_prefix = section.settings.caption_prefix

  assign average = 0
  assign total_count = 0
  assign count_5 = 0
  assign count_4 = 0
  assign count_3 = 0
  assign count_2 = 0
  assign count_1 = 0
  assign rating_sum = 0

  for review_entry in shop.metaobjects.review.values
    if section.settings.buyer_only and review_entry.reviewer_type.value != 'buyer'
      continue
    endif
    if review_entry.status.value != 'approved'
      continue
    endif
    assign r = review_entry.rating.value | plus: 0
    assign rating_sum = rating_sum | plus: r
    assign total_count = total_count | plus: 1
    if r == 5
      assign count_5 = count_5 | plus: 1
    elsif r == 4
      assign count_4 = count_4 | plus: 1
    elsif r == 3
      assign count_3 = count_3 | plus: 1
    elsif r == 2
      assign count_2 = count_2 | plus: 1
    elsif r == 1
      assign count_1 = count_1 | plus: 1
    endif
  endfor

  if total_count > 0
    assign average = rating_sum | times: 100 | divided_by: total_count | times: 0.01
  endif

  if section.settings.average_override != blank
    assign average = section.settings.average_override | times: 1.0
  endif
-%}

{%- if total_count > 0 -%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style reviews-surface reviews-surface--aggregate section-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="reviews-aggregate">
    {% render 'aggregate-rating-block',
      average: average,
      total_count: total_count,
      count_5: count_5,
      count_4: count_4,
      count_3: count_3,
      count_2: count_2,
      count_1: count_1,
      caption_prefix: caption_prefix,
      unique_id: section.id
    %}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Aggregate rating block",
  "tag": "section",
  "class": "reviews-section-aggregate",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "buyer_only",
      "label": "Buyer reviews only",
      "info": "Off on reviews-test so aggregate includes recipient, gifter, and accessory entries.",
      "default": false
    },
    {
      "type": "text",
      "id": "average_override",
      "label": "Average override (acceptance test)",
      "info": "e.g. 4.3 to verify fractional star gradient. Leave blank for computed average from metaobjects."
    },
    {
      "type": "text",
      "id": "caption_prefix",
      "label": "Caption prefix",
      "default": "From"
    }
  ],
  "presets": [
    {
      "name": "Aggregate rating block"
    }
  ]
}
{% endschema %}
